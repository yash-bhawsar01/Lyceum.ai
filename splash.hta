<html>

<head>

<title>Thinkarium</title>

<HTA:APPLICATION
  APPLICATIONNAME="Thinkarium"
  BORDER="none"
  CAPTION="no"
  SHOWINTASKBAR="no"
  SINGLEINSTANCE="yes"
  SYSMENU="no"
  SCROLL="no"
/>

<style>

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&display=swap');

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

html,
body{
  width:100%;
  height:100%;
  overflow:hidden;
  background:#0b0907;
}

/* FULLSCREEN CENTERING CONTAINER */
#wrapper{
  position:fixed;
  inset:0;
  display:flex;
  flex-direction:column; /* Stacks text above the logo */
  justify-content:center;
  align-items:center;
  /* Premium, moody dark amber gradient */
  background:
    radial-gradient(
      circle at center,
      #1a1005 0%,
      #0b0907 70%
    );
}

/* STARTING TEXT STYLE */
.loading-text {
  font-family: 'Cinzel', serif;
  color: #f59e0b;
  font-size: 1.5rem;
  letter-spacing: 6px;
  text-transform: uppercase;
  margin-bottom: 30px; /* Space between text and image */
  opacity: 0.8;
  text-shadow: 0 0 15px rgba(245, 158, 11, 0.4);
  animation: textGlow 2s ease-in-out infinite alternate;
}

/* GIANT LOGO */
img{
  width:55vw; 
  max-width:1000px;
  image-rendering:pixelated;
  animation: giantFlash 1.5s ease-in-out infinite;
}

/* INTENSE FLASH ANIMATION */
@keyframes giantFlash{
  0%, 100%{
    transform:scale(0.97);
    opacity:0.3;
    filter: drop-shadow(0 0 10px rgba(245, 158, 11, 0.2)) brightness(0.5);
  }
  50%{
    transform:scale(1.05);
    opacity:1;
    filter: drop-shadow(0 0 100px rgba(245, 158, 11, 0.8)) brightness(1.3);
  }
}

/* SUBTLE TEXT BREATHING ANIMATION */
@keyframes textGlow {
  from {
    opacity: 0.5;
    text-shadow: 0 0 10px rgba(245, 158, 11, 0.2);
  }
  to {
    opacity: 1;
    text-shadow: 0 0 25px rgba(245, 158, 11, 0.7);
  }
}

</style>

<script language="VBScript">
' Fixes the path issue so the image loads correctly when launched via VBScript
Sub Window_OnLoad
    window.moveTo 0, 0
    window.resizeTo screen.width, screen.height
    
    Dim fso, currentDir, imgPath
    Set fso = CreateObject("Scripting.FileSystemObject")
    
    currentDir = fso.GetParentFolderName(Replace(document.location.pathname, "file:///", ""))
    imgPath = currentDir & "\images\main.png"
    
    document.getElementById("splash-img").src = imgPath
End Sub
</script>

</head>

<body>

<div id="wrapper">

  <div class="loading-text">Starting...</div>

  <img id="splash-img" src="">

</div>

</body>

</html>